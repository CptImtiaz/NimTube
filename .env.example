# GLOBAL TOP 10 AI — environment variables.
# Locally: copy to .env and `export $(grep -v '^#' .env | xargs)` (or use direnv).
# On GitHub: add each as a repository SECRET (Settings -> Secrets and variables -> Actions). Never commit values.
# Only the variables marked REQUIRED are needed for the first private-upload test.

# ---------- AI text (at least ONE required) ----------
# Claude (recommended): https://console.anthropic.com -> API keys. Ask your org admin to ENABLE WEB SEARCH
# in the Claude Console (Settings -> Privacy/Features), research needs it.
ANTHROPIC_API_KEY=
# OpenAI: https://platform.openai.com/api-keys  (also used for TTS + images if those providers are enabled)
OPENAI_API_KEY=
# Google Gemini (MAIN AI, free tier): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# optional: force an exact model ID (default: newest stable Flash model your key can use)
GEMINI_MODEL=

# ---------- YouTube ----------
# REQUIRED for trend discovery. Google Cloud Console -> APIs & Services -> enable "YouTube Data API v3"
# -> Credentials -> Create credentials -> API key. Restrict it to the YouTube Data API.
YOUTUBE_API_KEY=
# REQUIRED for uploading. Run `python scripts/get_youtube_token.py` once on your computer (see docs/SETUP_GUIDE.md).
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# ---------- Research without model web search ----------
# Tavily (free 1,000 credits/month, no card): https://tavily.com  -> used automatically when set
TAVILY_API_KEY=
# NVIDIA API catalog (Nemotron) — FREE KEYS ARE FOR TESTING ONLY per NVIDIA's trial terms
NVIDIA_API_KEY=
NVIDIA_MODEL=
# DeepSeek API (cheap, commercial OK) / OpenRouter (free DeepSeek model)
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# ---------- Optional providers ----------
# ElevenLabs voice: https://elevenlabs.io/app/settings/api-keys  (+ a voice you are licensed to use)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Pexels licensed stock video: https://www.pexels.com/api/  (free; Pexels License)
PEXELS_API_KEY=
# Pixabay licensed stock video: https://pixabay.com/api/docs/  (free; Pixabay Content License)
PIXABAY_API_KEY=
# Reddit (official API, app-only): https://www.reddit.com/prefs/apps  -> "script" app
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=global-top10-ai/1.0 (by u/your_username)
# Optional model overrides
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium
GEMINI_IMAGE_MODEL=imagen-4.0-generate-001

# ---------- Zapier upload (default backend) ----------
# Zap: "Webhooks by Zapier - Catch Hook" -> "YouTube - Upload Video". Paste the Catch Hook URL here.
ZAPIER_UPLOAD_HOOK=
UPLOAD_BACKEND=zapier
# Railway bucket credentials (set automatically on Railway via variable references)
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- Automation ----------
# Manual single-video mode: test | private | dry-run
PRODUCTION_MODE=test
# REQUIRED on GitHub: long random passphrase (>=16 chars) that encrypts the database stored on the bot-state branch.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"   — keep a copy; losing it loses history.
STATE_PASSPHRASE=
# Optional: Slack/Discord-compatible webhook for failure notifications
NOTIFY_WEBHOOK_URL=

# ---------- Local paths (optional) ----------
DATA_DIR=
OUTPUT_DIR=
LOG_LEVEL=INFO
